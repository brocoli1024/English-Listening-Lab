{
  "name": "englishlisteningapp",
  "description": "Local English listening practice with lyrics, scoring and audio import",
  "author": "brocoli1024",
  "license": "MIT",
  "main": "expo/AppEntry.js",
  "version": "1.0.4",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.13",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "extract-zip": "2.0.1",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "source:review": "python scripts/export-source-review.py",
    "test:source-review": "python -m unittest discover -s scripts/tests -p test_source_review.py",
    "desktop:tools": "node scripts/prepare-desktop-tools.cjs",
    "test:desktop": "node --test desktop/tests/*.test.cjs scripts/tests/*.test.cjs",
    "desktop:export": "node scripts/prepare-support-content.cjs && expo export --platform web",
    "desktop:start": "npm run desktop:export && electron desktop/main.cjs",
    "desktop:build": "npm run desktop:export && electron-builder --win nsis --x64 --publish never",
    "desktop:check-package": "node scripts/check-desktop-package.cjs",
    "desktop:stage-release": "node scripts/stage-release.cjs"
  },
  "private": true,
  "overrides": {
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
  }
}
